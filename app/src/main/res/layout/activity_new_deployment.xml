<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/newDeploymentCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pocket_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/newDeploymentAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pocket_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/newDeploymentToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/pocket_on_surface"
            app:title="@string/new_deployment_title"
            app:titleTextColor="@color/pocket_on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Folder Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pocket_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/pocket_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Website Directory"
                        android:textColor="@color/pocket_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/choose_folder_prompt"
                        android:textColor="@color/pocket_on_surface_variant"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectFolder"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/pocket_surface_variant"
                        android:text="@string/action_select_folder"
                        android:textAllCaps="false"
                        android:textColor="@color/pocket_on_surface"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_folder_open"
                        app:iconTint="@color/pocket_primary" />

                    <!-- Selected Path Display -->
                    <TextView
                        android:id="@+id/txtSelectedPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="No folder selected"
                        android:textColor="@color/pocket_on_surface_variant"
                        android:textSize="12sp" />

                    <!-- Live Validation Banner -->
                    <LinearLayout
                        android:id="@+id/layoutValidationBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_code_box"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgValidationIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/status_live" />

                        <TextView
                            android:id="@+id/txtValidationMessage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/validation_success"
                            android:textColor="@color/status_live"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Project Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/pocket_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/pocket_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Project Details"
                        android:textColor="@color/pocket_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutProjectName"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/project_name_label"
                        app:boxStrokeColor="@color/pocket_primary"
                        app:hintTextColor="@color/pocket_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editProjectName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/pocket_on_surface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Hosting Mode Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/hosting_mode_label"
                        android:textColor="@color/pocket_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/radioGroupHostingMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioPublic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/mode_public_title"
                            android:textColor="@color/pocket_on_surface"
                            app:buttonTint="@color/pocket_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="@string/mode_public_desc"
                            android:textColor="@color/pocket_on_surface_variant"
                            android:textSize="12sp" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioLocal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/mode_local_title"
                            android:textColor="@color/pocket_on_surface"
                            app:buttonTint="@color/pocket_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="@string/mode_local_desc"
                            android:textColor="@color/pocket_on_surface_variant"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <!-- Preferred Subdomain (Public only) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutSubdomain"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/subdomain_label"
                        app:boxStrokeColor="@color/pocket_primary"
                        app:hintTextColor="@color/pocket_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editSubdomain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/pocket_on_surface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Local Port -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutPort"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/port_label"
                        app:boxStrokeColor="@color/pocket_primary"
                        app:hintTextColor="@color/pocket_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="8080"
                            android:textColor="@color/pocket_on_surface" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Advanced Switches Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/pocket_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/pocket_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Advanced Options"
                        android:textColor="@color/pocket_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- SPA Fallback Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/spa_fallback_title"
                                android:textColor="@color/pocket_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/spa_fallback_desc"
                                android:textColor="@color/pocket_on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSpaFallback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/pocket_primary"
                            app:trackTint="@color/pocket_primary_container" />
                    </LinearLayout>

                    <!-- Keep Awake Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/keep_awake_title"
                                android:textColor="@color/pocket_on_surface"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/keep_awake_desc"
                                android:textColor="@color/pocket_on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchKeepAwake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            app:thumbTint="@color/pocket_primary"
                            app:trackTint="@color/pocket_primary_container" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Deploy Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeployNow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:backgroundTint="@color/pocket_primary"
                android:enabled="false"
                android:text="@string/btn_deploy_now"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconTint="@color/white" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
