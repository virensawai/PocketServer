<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Method Pill -->
    <TextView
        android:id="@+id/txtLogMethod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_live"
        android:fontFamily="monospace"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="GET"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Path & Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtLogPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="/index.html"
            android:textColor="@color/pocket_on_surface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtLogMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="4.2 KB • 18ms • 01:22:33"
            android:textColor="@color/pocket_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Status Code Pill -->
    <TextView
        android:id="@+id/txtLogStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:text="200"
        android:textColor="@color/status_live"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
